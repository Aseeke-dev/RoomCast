{
    "name": "@roomcast/presenter",
    "version": "0.1.3",
    "private": true,
    "main": "./dist/main/index.js",
    "type": "module",
    "scripts": {
        "build:main": "tsc -p tsconfig.main.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
        "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
        "typecheck": "tsc -p tsconfig.json",
        "package": "pnpm --filter @roomcast/viewer build && pnpm --filter server... run build && pnpm build:main && pnpm build:renderer && electron-builder --win nsis",
        "watch:main": "concurrently -k \"tsc -p tsconfig.main.json --watch\" \"esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs --watch\"",
        "dev:renderer": "vite",
        "dev:electron": "NODE_ENV=development electron .",
        "start:electron-wait": "wait-on http://localhost:5173 && NODE_ENV=development electron .",
        "dev": "concurrently -k -n \"RENDERER,MAIN,ELECTRON\" -c \"cyan,yellow,magenta\" \"pnpm dev:renderer\" \"pnpm watch:main\" \"pnpm start:electron-wait\""
    },
    "dependencies": {
        "@roomcast/networking": "workspace:*",
        "@roomcast/protocol": "workspace:*",
        "@roomcast/types": "workspace:*",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-qr-code": "^2.2.0",
        "server": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^29.1.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.20.2",
        "typescript": "^5.3.3",
        "vite": "^5.1.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.roomcast.presenter",
        "productName": "RoomCast Presenter",
        "electronDist": "node_modules/electron/dist",
        "directories": {
            "output": "release"
        },
        "extraResources": [
            {
                "from": "../viewer/dist",
                "to": "viewer"
            },
            {
                "from": "build/icon.ico",
                "to": "icon.ico"
            }
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "${productName}-${version}-Setup.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico"
        }
    }
}
